{
  "name": "astro-paper",
  "type": "module",
  "version": "5.5.1",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/check-static-route-conflict.mjs && astro build",
    "preview": "astro preview",
    "sync": "astro sync",
    "astro": "astro",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint .",
    "cleanup:strikethrough": "python3 scripts/fix_strikethrough.py",
    "cleanup:integrity": "python3 scripts/fix_integrity.py",
    "scan:md": "node scripts/detect_duplicate_markdown_sections.mjs",
    "verify:svg-posts": "node scripts/verify-svg-posts.mjs",
    "diagrams:sanitize": "python3 scripts/sanitize_svg_xml.py",
    "diagrams:render": "node scripts/render-diagrams-to-webp.mjs",
    "diagrams:migrate-refs": "node scripts/migrate-svg-refs-to-webp.mjs",
    "verify:diagram-posts": "node scripts/verify-diagram-posts.mjs",
    "validate:post": "npx --yes tsx scripts/validate-blog-post.ts",
    "validate:batch": "SKIP_VALIDATE_BUILD=1 SKIP_TRUST_VERIFY=1 node scripts/batch-validate-posts.mjs",
    "trust:extract": "npx --yes tsx scripts/extract-claims-from-ko.mjs",
    "trust:parity": "npx --yes tsx scripts/locale-numeric-parity.mjs",
    "trust:verify-sources": "npx --yes tsx scripts/verify-claims-against-sources.mjs",
    "trust:update-index": "npx --yes tsx scripts/update-fact-audit-index.mjs",
    "trust:summary": "TRUST_SKIP_SOURCE_FETCH=1 npx --yes tsx scripts/trust-batch-summary.mjs",
    "check:source-links": "npx --yes tsx scripts/check-source-links.mjs",
    "trust:check-source-urls": "node scripts/check-source-urls.mjs",
    "verify:episode": "node scripts/verify-episode-manifest.mjs",
    "verify:episode:gate": "node scripts/verify-episode-manifest.mjs --require-gates",
    "verify:tokyo-changed": "node scripts/verify-tokyo-changed.mjs",
    "verify:tokyo:ci": "node scripts/verify-tokyo-changed.mjs --ci",
    "verify:manifest-parity": "node scripts/verify-manifest-locale-parity.mjs",
    "verify:pkm-income": "node scripts/sync-manifest-pkm-income.mjs",
    "scaffold:manifest": "node scripts/scaffold-episode-manifest.mjs",
    "fetch:suumo": "node scripts/fetch-suumo-snapshot.mjs",
    "collect:mlit": "node scripts/mlit-collector.mjs",
    "fetch:price-points": "node scripts/fetch-price-points.mjs",
    "fetch:appraisal": "node scripts/fetch-appraisal.mjs",
    "fetch:disaster-history": "node scripts/fetch-disaster-history.mjs",
    "fetch:evacuation-sites": "node scripts/fetch-evacuation-sites.mjs",
    "fetch:urban-planning": "node scripts/fetch-urban-planning.mjs",
    "merge:mlit-pkm": "node scripts/merge-mlit-price-to-pkm.mjs",
    "sync:mlit-ark": "node scripts/sync-mlit-pkm-to-ark.mjs",
    "sync:mlit-benchmarks": "node scripts/sync-mlit-to-benchmarks.mjs",
    "sync:suumo-benchmarks": "node scripts/sync-suumo-to-benchmarks.mjs",
    "dossier:ward": "node scripts/render-ward-dossier.mjs",
    "compare:wards": "node scripts/compare-wards.mjs",
    "verify:mlit-drift": "node scripts/verify-mlit-drift.mjs",
    "analyze:station-distance": "node scripts/analyze-station-distance.mjs",
    "analyze:disaster-price": "node scripts/analyze-disaster-price.mjs",
    "analyze:disaster-matrix": "node scripts/analyze-disaster-matrix.mjs",
    "analyze:redevelopment-potential": "node scripts/analyze-redevelopment-potential.mjs",
    "analyze:urban-constraints": "node scripts/analyze-urban-constraints.mjs",
    "verify:disaster-complete": "node scripts/verify-disaster-complete.mjs",
    "verify:urban-planning-complete": "node scripts/verify-urban-planning-complete.mjs",
    "render:ward-price-map": "node scripts/render-ward-price-map.mjs",
    "og:hero-jpeg": "node scripts/generate-hero-og-jpeg.mjs",
    "mlit:price-series": "node scripts/mlit-price-series.mjs",
    "mlit:trade-series": "node scripts/mlit-trade-price-series.mjs",
    "mlit:land-series": "node scripts/mlit-land-price-series.mjs",
    "research:pack": "node scripts/render-episode-research-pack.mjs",
    "analyze:episode": "node scripts/analyze-episode.mjs",
    "audit:ward-tiles": "node scripts/audit-ward-tiles.mjs",
    "verify:ep07-tiles": "node scripts/verify-ep07-tiles.mjs",
    "verify:station-passengers": "node scripts/verify-station-passengers.mjs",
    "audit:station-passengers": "node scripts/audit-station-passengers.mjs",
    "verify:og-social": "node scripts/verify-og-social.mjs",
    "screen:wards": "node scripts/screen-wards.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.6",
    "@astrojs/react": "^5.0.6",
    "@astrojs/rss": "^4.0.14",
    "@astrojs/sitemap": "^3.6.0",
    "@astrojs/vercel": "^9.0.5",
    "@libsql/client": "^0.17.3",
    "@milkdown/crepe": "^7.21.1",
    "@milkdown/kit": "^7.21.1",
    "@notionhq/client": "^2.2.15",
    "@pagefind/default-ui": "^1.4.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.1.18",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.4.0",
    "arctic": "^3.7.0",
    "astro": "^5.16.6",
    "dayjs": "^1.11.19",
    "dompurify": "^3.4.7",
    "gray-matter": "^4.0.3",
    "jose": "^6.2.3",
    "lodash.kebabcase": "^4.1.1",
    "pagefind": "^1.4.0",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "remark-collapse": "^0.1.2",
    "remark-gfm": "^4.0.1",
    "remark-toc": "^9.0.0",
    "satori": "^0.18.3",
    "sharp": "^0.34.5",
    "slugify": "^1.6.6",
    "tailwindcss": "^4.1.18",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@shikijs/transformers": "^3.20.0",
    "@tailwindcss/typography": "^0.5.19",
    "@turf/turf": "^7.3.5",
    "@types/lodash.kebabcase": "^4.1.9",
    "@typescript-eslint/parser": "^8.51.0",
    "eslint": "^9.39.2",
    "eslint-plugin-astro": "^1.5.0",
    "globals": "^16.5.0",
    "prettier": "^3.7.4",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.51.0",
    "xlsx": "^0.18.5"
  }
}
