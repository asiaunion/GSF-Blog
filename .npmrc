# Standalone install for this repo (avoid parent Antigravity pnpm workspace).
ignore-workspace-root-check=true

# ⚠️ 운영 메모 (2026-06-19 추가)
# package.json dependencies/devDependencies 변경 시 → 반드시 아래 순서로 lockfile을 갱신하고 커밋할 것.
# 미이행 시 Vercel frozen-lockfile 빌드 에러 발생 (사례: @turf/turf, xlsx 추가 후 누락 → ERR_PNPM_OUTDATED_LOCKFILE)
#
#   cd projects/GSF-Ark
#   pnpm install --ignore-workspace   # standalone lockfile 재생성
#   git add pnpm-lock.yaml
#   git commit -m "fix(build): pnpm-lock.yaml 업데이트 — <패키지명> 추가"
#   git push origin main

