---
import AboutLayout from "@/layouts/AboutLayout.astro";
import { getEntry, render } from "astro:content";
import { PUBLIC_PROFILES } from "@/config";

export function getStaticPaths() {
  return [
    { params: { locale: undefined } },
    { params: { locale: "ko" } },
    { params: { locale: "ja" } },
  ];
}

const { locale } = Astro.params;
const lang = (locale as "ko" | "ja" | undefined) ?? "en";

const entry = await getEntry("author", lang);
if (!entry) {
  throw new Error(`Author entry not found for locale: ${lang}`);
}

const { Content } = await render(entry);
---

<AboutLayout
  frontmatter={{
    title: entry.data.title,
    description: entry.data.description,
    sameAs: [PUBLIC_PROFILES.linkedIn, PUBLIC_PROFILES.x],
  }}
  schemaType="ProfilePage"
>
  <Content />
</AboutLayout>
