---
/**
 * Admin 메모 목록 페이지
 * prerender=false 필수 (SSR)
 */
import AdminLayout from "@/layouts/AdminLayout.astro";
import PostList from "@/admin/components/PostList";

export const prerender = false;

type AdminUser = { email: string; name: string; picture?: string };
const user = (Astro.locals as Record<string, unknown>).user as AdminUser | undefined;
---

<AdminLayout title="메모장 — GSF-Blog Admin" user={user}>
  <main>
    <div class="max-w-7xl mx-auto px-4 mt-6">
      <a href="/admin/" class="text-sm opacity-80 hover:text-accent transition-colors mb-2 inline-block">← 대시보드로 돌아가기</a>
    </div>
    <PostList defaultStatusFilter="memo" client:only="react" />
  </main>
</AdminLayout>
