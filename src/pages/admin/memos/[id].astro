---
/**
 * Admin 메모 편집기
 * prerender=false 필수 (SSR)
 */
import AdminLayout from "@/layouts/AdminLayout.astro";
import Editor from "@/admin/components/Editor";

export const prerender = false;

const { id } = Astro.params;

if (!id) {
  return new Response("ID 누락", { status: 400 });
}

type AdminUser = { email: string; name: string; picture?: string };
const user = (Astro.locals as Record<string, unknown>).user as AdminUser | undefined;
---

<AdminLayout title="메모 편집 — GSF-Blog Admin" user={user}>
  <main>
    <Editor id={id} client:only="react" />
  </main>
</AdminLayout>
