---
/**
 * Admin 포스트 개별 편집 페이지
 * prerender=false 필수 (SSR)
 *
 * @see §14 세션 2-B: Milkdown 에디터 기본 + API CRUD
 */
import AdminLayout from "@/layouts/AdminLayout.astro";
import Editor from "@/admin/components/Editor";

export const prerender = false;

const { id } = Astro.params;

type AdminUser = { email: string; name: string; picture?: string };
const user = (Astro.locals as Record<string, unknown>).user as AdminUser | undefined;

if (!id) {
  return Astro.redirect("/admin/posts/");
}
---

<AdminLayout title="에디터 — GSF-Blog Admin" user={user}>
  <main>
    {/* client:only="react"를 사용하여 완벽한 에디터 마운트 수행 */}
    <Editor client:only="react" id={id} />
  </main>
</AdminLayout>
