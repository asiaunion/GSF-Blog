---
import type { HTMLAttributes } from "astro/types";

import { getUi, type UiLang } from "@/i18n/ui";

const currentYear = new Date().getFullYear();

type Props = {
  noMarginTop?: boolean;
  uiLang?: UiLang;
} & HTMLAttributes<"footer">;

const {
  noMarginTop = false,
  uiLang: uiLangProp,
  class: className,
  ...attrs
} = Astro.props;

const { locale } = Astro.params;
const lang = (
  uiLangProp ??
  (locale === "ko" || locale === "ja" ? locale : "en")
) as UiLang;
const l = lang === "en" ? "" : `/${lang}`;
const L = getUi(lang);

---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div class="py-6 sm:py-8 border-t border-border flex flex-col gap-4 sm:gap-6">
    <div class="flex items-center justify-center sm:justify-start">
      <div class="flex items-center flex-wrap justify-center sm:justify-start text-sm opacity-80 gap-3 sm:gap-4">
        <a href={`${l}/about/`} class="link-subtle">{L.footerAbout}</a>
        <span>&middot;</span>
        <a href={`${l}/mission/`} class="link-subtle">{L.authorEeatMissionCta}</a>
        <span>&middot;</span>
        <a href={`${l}/methodology/`} class="link-subtle">{L.authorEeatMethodologyCta}</a>
        <span>&middot;</span>
        <a href={`${l}/author/joseph-kim/`} class="link-subtle">{L.authorEeatProfileCta}</a>
        <span>&middot;</span>
        <a href={`${l}/contact/`} class="link-subtle">{L.footerContact}</a>
        <span>&middot;</span>
        <a href={`${l}/privacy-policy/`} class="link-subtle">{L.footerPrivacy}</a>
        <span>&middot;</span>
        <a href={`${l}/terms-of-service/`} class="link-subtle">{L.footerTerms}</a>
      </div>
    </div>
    <div class="flex flex-col sm:flex-row items-center justify-center sm:justify-start text-xs sm:text-sm opacity-60 text-center sm:text-left gap-1 sm:gap-2">
      <span>{L.footerCopyright} &#169; {currentYear} GSF (Good Samaritan Flourishing).</span>
      <span class="hidden sm:inline">&nbsp;|&nbsp;</span>
      <span>{L.footerAllRights}</span>
    </div>
    <div class="text-xs opacity-60 text-center sm:text-left">
      <span>{L.footerAdsNotice}</span>
    </div>

  </div>
</footer>
