---
import { getUi, type UiLang } from "@/i18n/ui";

type Props = {
  lang?: UiLang;
  class?: string;
};

const { lang: langProp, class: className } = Astro.props;
const { locale } = Astro.params;
const navLang = (langProp ?? locale ?? "en") as UiLang;
const L = getUi(navLang);

const content = {
  en: {
    title: "Get the Tokyo D-90 Checklist — free.",
    desc: "Weekly Tokyo real estate data, delivered to your inbox.",
    cta: "Subscribe →"
  },
  ko: {
    title: "도쿄 D-90 체크리스트 무료 받기",
    desc: "주간 도쿄 부동산 데이터, 뉴스레터로 받아보세요.",
    cta: "구독하기 →"
  },
  ja: {
    title: "東京D-90チェックリストを無料で入手",
    desc: "週刊東京不動産データをニュースレターでお届けします。",
    cta: "購読する →"
  }
};

const c = content[navLang] ?? content.en;
---

<section class={`mx-auto w-full px-4 pt-12 pb-2 ${className || ""}`}>
  <div class="rounded-2xl border border-border bg-card p-6 sm:p-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 overflow-hidden relative shadow-sm hover:shadow-md transition-shadow">
    <div class="absolute top-0 right-0 -mt-16 -mr-16 w-48 h-48 bg-accent/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="flex-1 relative z-10">
      <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-foreground">{c.title}</h2>
      <p class="mt-2 text-sm sm:text-base text-foreground/75 leading-relaxed">{c.desc}</p>
    </div>
    <div class="shrink-0 w-full sm:w-auto relative z-10 flex flex-col items-stretch">
      <a
        href="https://buttondown.com/GSFArk"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex w-full justify-center whitespace-nowrap rounded-full bg-accent px-6 py-3 text-sm font-semibold text-white shadow-md transition-all hover:scale-105 hover:shadow-lg active:scale-[0.98]"
      >
        {c.cta}
      </a>
    </div>
  </div>
</section>
