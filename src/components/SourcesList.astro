---
/**
 * SourcesList — numbered sources with optional rich citations (label, archive, portal).
 * Inline body uses <sup class="source-ref"><a href="#source-N">N</a></sup>.
 */
import type { UiLang } from "@/i18n/ui";
import type { CiteSource } from "@/lib/sourceCitations";

type Props = {
  sources: string[];
  citeSources?: CiteSource[];
  lang?: UiLang | string;
};

const { sources, citeSources = [], lang = "en" } = Astro.props;

const labels: Record<
  string,
  { title: string; note: string; official: string; archive: string; portal: string; pdf: string }
> = {
  en: {
    title: "Sources & References",
    note: "URLs verified at the time of writing. Archived snapshots open from this site for headline statistics.",
    official: "Official",
    archive: "Archive",
    portal: "Portal",
    pdf: "PDF",
  },
  ko: {
    title: "출처 및 참고 자료",
    note: "URL은 작성 시점 기준으로 확인했습니다. 헤드라인 통계는 아래 ‘보관’ 링크로 당시 스냅샷을 열 수 있습니다.",
    official: "공식",
    archive: "보관",
    portal: "포털",
    pdf: "PDF",
  },
  ja: {
    title: "出典・参考資料",
    note: "URLは執筆時点で確認済みです。見出し統計は下の「アーカイブ」から当時のスナップショットを開けます。",
    official: "公式",
    archive: "アーカイブ",
    portal: "ポータル",
    pdf: "PDF",
  },
};

const L = labels[lang as string] ?? labels.en;

function toDomain(url: string): string {
  try {
    return new URL(url).hostname.replace(/^www\./, "");
  } catch {
    return url;
  }
}

const useRich = citeSources.length > 0;
const simpleOnly = !useRich && sources.length > 0;
---

{
  (useRich || simpleOnly) && (
    <section class="sources-panel mt-10 rounded-xl border border-border bg-card p-5">
      <h2 class="text-base font-semibold">{L.title}</h2>
      {useRich ? (
        <ol class="mt-3 list-none space-y-4 pl-0 text-sm leading-relaxed text-foreground/80">
          {citeSources.map((item, index) => {
            const n = index + 1;
            return (
              <li id={`source-${n}`} class="scroll-mt-24 border-b border-border/60 pb-4 last:border-0 last:pb-0">
                <span class="mr-2 font-semibold text-accent">{n}.</span>
                <span class="font-medium text-foreground">{item.label}</span>
                <div class="mt-1.5 flex flex-wrap gap-x-3 gap-y-1">
                  <a
                    href={item.url}
                    target="_blank"
                    rel="noopener noreferrer nofollow"
                    class="underline decoration-foreground/25 underline-offset-2 hover:text-accent"
                  >
                    {L.official}
                  </a>
                  {item.secondaryUrl && (
                    <a
                      href={item.secondaryUrl}
                      target="_blank"
                      rel="noopener noreferrer nofollow"
                      class="underline decoration-foreground/25 underline-offset-2 hover:text-accent"
                    >
                      {L.pdf}
                    </a>
                  )}
                  {item.archive && (
                    <a
                      href={item.archive}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="underline decoration-dotted underline-offset-2 hover:text-accent"
                    >
                      {L.archive}
                    </a>
                  )}
                  {item.portal && (
                    <a
                      href={item.portal}
                      target="_blank"
                      rel="noopener noreferrer nofollow"
                      class="underline decoration-foreground/25 underline-offset-2 hover:text-accent"
                    >
                      {L.portal}
                    </a>
                  )}
                </div>
                <p class="mt-1 text-xs text-foreground/45 break-all">{toDomain(item.url)}</p>
              </li>
            );
          })}
        </ol>
      ) : (
        <ol class="mt-3 list-decimal space-y-1.5 pl-5 text-sm leading-relaxed text-foreground/75">
          {sources.map(url => (
            <li>
              <a
                href={url}
                target="_blank"
                rel="noopener noreferrer nofollow"
                class="break-all underline decoration-foreground/25 underline-offset-2 transition-colors hover:text-accent hover:decoration-accent"
              >
                {toDomain(url)}
              </a>
            </li>
          ))}
        </ol>
      )}
      <p class="mt-3 text-xs italic text-foreground/50">{L.note}</p>
    </section>
  )
}
