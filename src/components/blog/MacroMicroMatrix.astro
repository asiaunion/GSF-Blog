---
interface Props {
  leftTitle: string;
  leftItems: string[];
  rightTitle: string;
  rightItems: string[];
}

const { leftTitle, leftItems, rightTitle, rightItems } = Astro.props;
---

<div class="macro-micro-matrix">
  <div class="matrix-card left-card">
    <h4>{leftTitle}</h4>
    <div class="card-content">
      {leftItems.map((item) => (
        <p set:html={item}></p>
      ))}
    </div>
  </div>
  <div class="matrix-card right-card">
    <h4>{rightTitle}</h4>
    <div class="card-content">
      {rightItems.map((item) => (
        <p set:html={item}></p>
      ))}
    </div>
  </div>
</div>

